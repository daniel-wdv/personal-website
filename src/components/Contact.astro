---
import Icon from "./Icon.astro";
import Section from "./Section.astro";
import { site } from "../config/site";
---

<Section id="contact" label="Contact">
  <p class="text-lg leading-relaxed text-muted text-pretty">
    If any of this sounds useful to your team, I would be glad to hear from you.
    The quickest way to reach me is email or linkedin :)
  </p>

  <a
    href={`mailto:${site.email}`}
    class="mt-6 inline-flex items-center gap-2.5 rounded-lg border border-accent px-5 py-3 font-mono text-sm text-accent transition-colors hover:bg-accent hover:text-bg"
  >
    <Icon name="mail" class="size-4.5 shrink-0" />
    {site.email}
  </a>
</Section>
