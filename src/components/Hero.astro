---
import Icon from "./Icon.astro";
import { site } from "../config/site";
import { images } from "../config/images";
---

<header
  id="top"
  class="mx-auto flex min-h-svh max-w-2xl flex-col justify-center px-6 py-24"
>
  <div class="enter flex items-center gap-5 sm:gap-6" style="--i: 0">
    <img
      src={images.portrait.src}
      srcset={images.portrait.srcset}
      sizes={images.portrait.sizes}
      width={images.portrait.width}
      height={images.portrait.height}
      alt={site.name}
      fetchpriority="high"
      class="size-32 shrink-0 rounded-full border-2 border-accent object-cover sm:size-40"
    />

    <div class="min-w-0">
      <p class="font-mono text-xs tracking-[0.2em] text-accent uppercase">
        {site.role}
      </p>

      <h1 class="mt-2 text-3xl font-semibold tracking-tight text-balance sm:text-5xl">
        {site.name}
      </h1>
    </div>
  </div>

  <p class="enter enter-fade mt-7 max-w-xl text-lg leading-relaxed text-muted text-pretty" style="--i: 1">
    I like picking up a problem that is not fully defined yet, asking the
    questions needed to understand it and turning it into something that works
    in production.
  </p>

  <nav class="enter enter-fade mt-10 flex flex-wrap gap-x-6 gap-y-3 font-mono text-sm" style="--i: 2">
    {
      site.links.map((link) => (
        <a
          href={link.href}
          class="group flex items-center gap-2 text-muted transition-colors hover:text-accent"
        >
          <Icon name={link.icon} class="size-4.5 shrink-0" />
          <span class="underline decoration-border underline-offset-4 transition-colors group-hover:decoration-accent">
            {link.label}
          </span>
        </a>
      ))
    }
  </nav>

  <a
    href="#about"
    style="--i: 3"
    class="enter enter-fade mt-20 flex items-center gap-2.5 font-mono text-xs tracking-[0.2em] text-muted uppercase transition-colors hover:text-accent"
  >
    Scroll
    <Icon name="arrow-down" class="size-5 shrink-0" />
  </a>
</header>

<style>
  /* A one-time entrance on page load.

     The hidden state lives ONLY in the keyframes, never in the resting rule.
     An earlier version set `opacity: 0` on the element and relied on the
     animation plus `forwards` to reveal it, which meant anything that stopped
     the animation running left the text invisible for good. Under reduced
     motion that is exactly what happened: no animation, no duration, permanently
     blank tagline and links.

     Animating the portrait's opacity is also off limits, separately: Chrome
     will not treat an element at `opacity: 0` as an LCP candidate, so fading it
     stops Largest Contentful Paint being recorded at all. It moves, never fades. */
  @media (prefers-reduced-motion: no-preference) {
    .enter {
      /* `backwards` holds the from-state through the delay. */
      animation: enter 0.5s cubic-bezier(0.22, 1, 0.36, 1) backwards;
      animation-delay: calc(var(--i) * 90ms);
    }

    .enter-fade {
      animation-name: enter-fade;
    }
  }

  /* Only `from` is declared: the end state is the element's own resting style,
     so nothing here is required for the content to be visible. */
  @keyframes enter {
    from {
      translate: 0 0.75rem;
    }
  }

  @keyframes enter-fade {
    from {
      opacity: 0;
      translate: 0 0.75rem;
    }
  }
</style>
